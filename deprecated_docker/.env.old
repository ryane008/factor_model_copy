# -----------------------------------------------------------------------------
# Development Settings (Optional)
# -----------------------------------------------------------------------------
# Additional configuration for development and debugging
#
# Environment mode (development/production)
ENVIRONMENT=development

# Logging level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Data processing batch sizes (adjust for performance)
INFLUXDB_BATCH_SIZE=5000
INFLUXDB_FLUSH_INTERVAL=10000

# =============================================================================
# USAGE EXAMPLES:
# =============================================================================
#
# 1. Basic setup (minimum required):
#    WRDS_USERNAME=your_username
#    WRDS_PASSWORD=your_password
#
# 2. Custom InfluxDB (if running external instance):
#    INFLUXDB_HOST=localhost
#    INFLUXDB_PORT=8087
#    INFLUXDB_TOKEN=your_custom_token
#
# 3. Production environment:
#    ENVIRONMENT=production
#    LOG_LEVEL=WARNING
