WRDS_PASSWORD=botqim-piztoc-1xeDro

# -----------------------------------------------------------------------------
# InfluxDB Configuration (Optional - uses defaults if not specified)
# -----------------------------------------------------------------------------
# These are pre-configured for Docker but can be customized if needed
#
# InfluxDB Connection Settings
INFLUXDB_AT_HOME_EMAIL=ryan_eng@brown.edu
INFLUXDB_TOKEN=apiv3_3gzBMvMXR4zN7lv5wcGPfOS5s7KOgMSLnTaR25OtAzli2MYfBVWT14ONIdv-8Kdzk7mT5yosBjzQNCQnyxyezQ

