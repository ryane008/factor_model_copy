INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_ORG=qtab
INFLUXDB_BUCKET=jkp_factors

# InfluxDB Admin Credentials (for web UI access)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=factormodel2024

# -----------------------------------------------------------------------------
# Jupyter Lab Configuration (Optional)
# -----------------------------------------------------------------------------
# Custom Jupyter settings (uses defaults if not specified)
#
JUPYTER_TOKEN=qtab_jupyter_2024
