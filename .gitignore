# =============================================================================
# QTAB Factor Modeling - Git Ignore Rules
# =============================================================================

# Environment files (CRITICAL: Contains sensitive credentials)
.env
.env.local
.env.production
.env.development
*.env
# Any other .env variant (.env.old, .env.backup, ...). deprecated_docker/.env.old was
# committed this way with live credentials. Only templates are ever committed.
.env.*
*.env.*
!.env.template
!**/.env.template*

# WRDS cache and temporary files
.wrds_cache/
*.wrds
wrds_cache/

# Python virtual environments
/qtab_env
venv/
env/
ENV/
factor_env/

# Data files (large datasets should not be in git)
us_equity.csv
data/
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
shared-data/*.csv
shared-data/*.parquet

# But keep example/template data files
!shared-data/README.md
!shared-data/.gitkeep
!**/example_*.csv
!**/sample_*.csv

# InfluxDB data (when running locally)
influxdb_data/
influxdb_config/

# Jupyter notebook files
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# Log files
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Docker volumes and runtime files
docker-compose.override.yml

# Backup files
*.bak
*.backup
backup/
backups/

# Research output files
output/
results/
reports/
figures/
plots/

# But keep important documentation
!README.md
!**/README.md
!docs/
!documentation/
