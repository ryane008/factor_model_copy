# =============================================================================
# QTAB Factor Modeling — Environment Configuration
# =============================================================================
#
# SETUP:
#   1. cp .env.template .env
#   2. Fill in your WRDS credentials below
#   3. docker compose up -d
#
# SECURITY:
#   - .env is gitignored. This template is not — never put real secrets here.
#   - Credentials can also leak through *notebook output*. Never print a
#     password to a cell, and clear outputs before committing.
#   - Each team member keeps their own .env.
#
# =============================================================================

# -----------------------------------------------------------------------------
# WRDS credentials (REQUIRED for any data loading)
# -----------------------------------------------------------------------------
# From your WRDS account: https://wrds-www.wharton.upenn.edu/
WRDS_USERNAME=your_wrds_username
WRDS_PASSWORD=your_wrds_password

# -----------------------------------------------------------------------------
# TimescaleDB / Postgres
# -----------------------------------------------------------------------------
# These seed the database container on first boot AND are what the notebooks
# connect with, so both sides stay in sync automatically.
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=factor_db
PGPORT=5432

# NOTE: PGHOST is deliberately NOT set here.
#
# The hostname differs depending on where the code runs, and it resolves without
# any branching:
#   - Inside the jupyter container, docker-compose.yml sets PGHOST=timescaledb
#     under `environment:`, which takes precedence over this env_file.
#   - Outside the container (local venv, host Jupyter, a script), PGHOST is
#     unset and ryan/sample/db.py defaults to localhost, where compose publishes
#     port 5432.
#
# Setting PGHOST here would work today only because compose overrides it, so
# leave it out and let the default do the job. Set it explicitly only if your
# database lives somewhere other than this compose stack.

# -----------------------------------------------------------------------------
# Jupyter Lab
# -----------------------------------------------------------------------------
JUPYTER_TOKEN=qtab_jupyter_2024
JUPYTER_PORT=8888
